.hero { padding: 40rpx 32rpx 32rpx; border-bottom: 2rpx solid var(--line); }
.brand { display: flex; align-items: center; gap: 20rpx; }
.mark {
  width: 76rpx; height: 76rpx; border-radius: 18rpx; background: var(--bg-ink);
  display: flex; flex-wrap: wrap; padding: 14rpx; gap: 6rpx; flex: none;
  box-shadow: 0 0 0 2rpx var(--accent), 0 0 26rpx rgba(167,139,250,.45);
}
.sq { width: 20rpx; height: 20rpx; border-radius: 5rpx; }
.sq-a { background: #a78bfa; }
.sq-b { background: rgba(242,241,238,.55); }
.sq-c { background: rgba(242,241,238,.55); }
.sq-d { background: #2d81ff; }
.brand-name { font-size: 32rpx; font-weight: 700; letter-spacing: -.5rpx; }
.brand-sub { font-size: 19rpx; letter-spacing: 3rpx; color: var(--faint); }

.grid2 { display: flex; flex-wrap: wrap; gap: 16rpx; }
.mini-card {
  width: calc(50% - 8rpx); background: var(--bg-raised); border: 2rpx solid var(--line);
  border-radius: var(--radius-lg); padding: 24rpx 26rpx;
}
.mini-v { display: block; font-size: 36rpx; font-weight: 700; margin-top: 8rpx; }

.beh-row { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 0; border-bottom: 2rpx solid var(--line); }
.beh-row:last-child { border-bottom: none; }
.beh-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.feat-row { padding: 16rpx 0; border-bottom: 2rpx solid var(--line); }
.feat-row:last-child { border-bottom: none; }
.feat-t { display: block; font-weight: 600; }
.feat-d { display: block; margin-top: 6rpx; line-height: 1.6; }

.tech-row { display: flex; justify-content: space-between; padding: 10rpx 0; }
