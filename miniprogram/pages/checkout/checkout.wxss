.steps { display: flex; align-items: center; justify-content: center; gap: 12rpx; padding: 32rpx 0; border-bottom: 2rpx solid var(--line); }
.step { display: flex; align-items: center; gap: 10rpx; }
.sdot {
  width: 44rpx; height: 44rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center;
  font-family: "SF Mono", Menlo, monospace; font-size: 23rpx;
  border: 2rpx solid var(--line-mid); color: var(--faint); background: var(--bg-raised);
}
.step.on .sdot { background: var(--bg-ink); border-color: var(--bg-ink); color: #f2f1ee; }
.slabel { font-size: 25rpx; color: var(--faint); }
.step.on .slabel { color: var(--ink); font-weight: 600; }
.sline { width: 48rpx; height: 2rpx; background: var(--line-mid); }

.ph { color: var(--ghost); }

.ch-card {
  display: flex; align-items: center; gap: 20rpx; padding: 26rpx;
  border: 2rpx solid var(--line); border-radius: var(--radius-lg);
  background: var(--bg-raised); margin-bottom: 16rpx;
}
.ch-card.on { border-color: var(--accent); background: #fff; box-shadow: 0 0 0 2rpx var(--accent-soft); }
.radio { width: 36rpx; height: 36rpx; border-radius: 50%; border: 2rpx solid var(--line-strong); flex: none; }
.radio.on { border-color: var(--accent-ink); background: var(--accent-ink); box-shadow: inset 0 0 0 6rpx var(--bg-raised); }

.bom-row { display: flex; align-items: center; gap: 16rpx; padding: 14rpx 0; }
.bom-name { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.cost-line { display: flex; align-items: center; gap: 16rpx; padding: 10rpx 0; }

.countdown { font-size: 40rpx; font-weight: 700; letter-spacing: -1rpx; }

.okmark {
  width: 96rpx; height: 96rpx; border-radius: 50%; flex: none;
  background: var(--ok-soft); color: var(--ok); font-size: 48rpx;
  display: flex; align-items: center; justify-content: center;
}

.actionbar {
  position: fixed; left: 0; right: 0; bottom: 0; z-index: 20;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(250,249,247,.96); border-top: 2rpx solid var(--line-mid);
}
