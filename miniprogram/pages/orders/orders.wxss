.stats { display: flex; flex-wrap: wrap; background: var(--bg-sunken); border-bottom: 2rpx solid var(--line); }
.stat { width: 50%; padding: 26rpx 32rpx; border-bottom: 2rpx solid var(--line); }
.stat:nth-child(odd) { border-right: 2rpx solid var(--line); }
.stat:nth-child(3), .stat:nth-child(4) { border-bottom: none; }
.stat-v { display: block; font-size: 38rpx; font-weight: 700; margin-top: 6rpx; }

.filter-bar { background: var(--bg); border-bottom: 2rpx solid var(--line); }
.chips-inner { display: inline-flex; padding: 18rpx 32rpx; }

.order {
  background: var(--bg-raised); border: 2rpx solid var(--line);
  border-radius: var(--radius-lg); padding: 26rpx; margin-bottom: 20rpx;
}

.tl { display: flex; gap: 18rpx; padding-bottom: 20rpx; }
.tl:last-child { padding-bottom: 0; }
.tl-dot {
  width: 18rpx; height: 18rpx; border-radius: 50%; background: var(--line-mid);
  flex: none; margin-top: 8rpx;
}
.tl-dot.on { background: var(--accent); box-shadow: 0 0 0 6rpx var(--accent-soft); }
